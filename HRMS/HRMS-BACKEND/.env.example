# HRMS Backend Production Environment Configuration
NODE_ENV=production
PORT=3000
SERVER_PORT=3000
HOST=127.0.0.1

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=hrms_user
DB_PASSWORD=replace_with_secure_password
DB_NAME=hrms

# JWT & Authentication Secret
JWT_SECRET=replace_with_a_secure_random_jwt_secret

# Logging Level
LOG_LEVEL=info
