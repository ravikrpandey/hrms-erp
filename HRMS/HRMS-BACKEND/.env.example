# HRMS Backend Production Environment Configuration
NODE_ENV=production
PORT=3000
SERVER_PORT=3000
HOST=127.0.0.1

# MySQL Database Configuration (Lightsail Localhost Only)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=mytaxuser
DB_PASSWORD=replace_with_secure_password
DB_NAME=hrms

# JWT & Authentication Secret (Set a strong random secret in production)
JWT_SECRET=replace_with_a_secure_random_jwt_secret

# Cloudflare Worker -> Lightsail Bridge Authentication & URLs
BRIDGE_SECRET=replace_with_strong_random_bridge_secret
CORS_ORIGINS=https://ravikrpandey.github.io
APP_PUBLIC_URL=https://hrms-api.your-subdomain.workers.dev/
APP_FRONTEND_URL=https://ravikrpandey.github.io/hrms-erp

# Logging Level
LOG_LEVEL=info
